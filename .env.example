# ---------- Primary AI: Google Gemini ----------
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
# Second Gemini model, used when the primary is overloaded (503), rate-limited or out of daily quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Minimum seconds between AI calls (keeps a batch under free-tier per-minute limits)
GEMINI_MIN_INTERVAL_S=4

# ---------- Anthropic Claude (optional, also reads scanned PDFs) ----------
# Key from platform.claude.com -> Settings -> API keys. Run scripts/check_ai.py to see your model IDs.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_VERSION=2023-06-01
# Only needed for keys that are not tied to a workspace:
# ANTHROPIC_WORKSPACE_ID=

# Which provider is tried first (comma-separated): gemini, claude, backups
AI_PROVIDER_ORDER=gemini,claude,backups

# ---------- Optional backup providers (any OpenAI-compatible API) ----------
# Used only when every Gemini model is unavailable. Scanned PDFs always stay on Gemini.
# PRIVACY: every provider you enable receives the supplier documents. Use synthetic data,
# or get approval before enabling a provider for real company documents.
# Check each provider's website for current model names.
#
# OpenAI (ChatGPT API, paid):
# LLM2_NAME=openai
# LLM2_BASE_URL=https://api.openai.com/v1
# LLM2_MODEL=gpt-4o-mini
# LLM2_API_KEY=sk-...
#
# Groq (has a free tier):
# LLM3_NAME=groq
# LLM3_BASE_URL=https://api.groq.com/openai/v1
# LLM3_MODEL=llama-3.3-70b-versatile
# LLM3_API_KEY=gsk_...
#
# OpenRouter (one key, many models):
# LLM4_NAME=openrouter
# LLM4_BASE_URL=https://openrouter.ai/api/v1
# LLM4_MODEL=<model id from openrouter.ai/models>
# LLM4_API_KEY=sk-or-...
#
# Local model with Ollama (free, documents never leave your PC; no key needed):
# LLM5_NAME=ollama
# LLM5_BASE_URL=http://localhost:11434/v1
# LLM5_MODEL=llama3.1

# ---------- Google Sheets export (optional) - see docs/google_sheets_setup.md ----------
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
